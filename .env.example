# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTHENTICATION & SECURITY CONFIGURATION
# Set a strong, randomly generated secret for production token signing
AUTH_SECRET="your-random-64-character-hex-secret-here"
AUTH_DEV_MODE="false"

# SMS PROVIDER (Twilio / MSG91 / Vonage)
SMS_PROVIDER="twilio"
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM=""

# EMAIL PROVIDER (SendGrid / Resend / SMTP)
EMAIL_PROVIDER="sendgrid"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@sentinelfin.com"

# NEO4J GRAPH DATABASE CONFIGURATION
# Set these variables to connect your Neo4j instance (AuraDB or self-hosted)
NEO4J_URI="neo4j+s://xxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

